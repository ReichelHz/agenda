# ─────────────────────────────────────────────
# Variables de entorno — Stefani Leiva Frontend
# ─────────────────────────────────────────────
# Copiá este archivo como .env y completá los valores.
# Las variables sin prefijo NEXT_PUBLIC_ solo son accesibles
# del lado del servidor (Route Handlers). Nunca expongas
# secretos con el prefijo NEXT_PUBLIC_.

# URL pública del backend Spring Boot
# En producción apuntar a Render.
NEXT_PUBLIC_API_URL=https://agenda-dirh.onrender.com

# Entorno de ejecución (development | production | test)
NODE_ENV=development
